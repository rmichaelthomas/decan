{
  "name": "decan",
  "version": "0.0.0",
  "description": "Human-first, agent-friendly temporal intent reference implementation for Proper Time.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "docs/conformance.md",
    "docs/consumer-evidence-pass.md",
    "docs/examples.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmichaelthomas/decan.git"
  },
  "keywords": [
    "temporal-intent",
    "scheduling",
    "rrule",
    "cron",
    "agents",
    "proper-time"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "fast-check": "^4.9.0",
    "json-canonicalize": "^1.1.1"
  }
}

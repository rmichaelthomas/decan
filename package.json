{
  "name": "decan",
  "version": "1.0.0",
  "description": "Human-first, agent-friendly temporal intent reference implementation for Proper Time.",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/commands.d.ts",
      "import": "./dist/cli/commands.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "decan": "./dist/cli/index.js",
    "decan-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "docs/conformance.md",
    "docs/consumer-evidence-pass.md",
    "docs/examples.md",
    "docs/proper-time-corpus.md",
    "docs/launch-argument.md",
    "site/index.html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmichaelthomas/decan.git"
  },
  "keywords": [
    "temporal-intent",
    "scheduling",
    "rrule",
    "cron",
    "agents",
    "proper-time"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/mark-bins-executable.mjs",
    "cli": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "fast-check": "^4.9.0",
    "json-canonicalize": "^1.1.1",
    "zod": "^4.4.3"
  }
}
